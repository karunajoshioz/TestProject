meta {
  name: Update customer
  type: http
  seq: 6
}

put {
  url: {{baseUrl}}/api/v1/customers/{{customerId}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "name": "Bruno Updated",
    "email": "bruno.smoke@example.com"
  }
}

assert {
  res.status: eq 200
  res.body.name: eq Bruno Updated
}
